variable "Project.Placeholder" {
    value "Octopus Deploy from Dev!" {
        description = "Placeholder text"
        environment = ["development"]

        prompt {
            description = "Enter the placeholder text"
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "Placeholder text"
            required = true
        }
    }

    value "Octopus Deploy from Test!" {
        description = "Placeholder text"
        environment = ["test"]

        prompt {
            description = "Enter the placeholder text"
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "Placeholder text"
            required = true
        }
    }

    value "Octopus Deploy from #{Octopus.Environment.Name}!" {
        description = "Placeholder text"

        prompt {
            description = "Enter the placeholder text"
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "Placeholder text"
            required = true
        }
    }
}